{
  "expo": {
    "name": "Lirune Reader",
    "slug": "lirune-reader",
    "version": "4.0.4",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1D"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "lirune",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lirune.reader"
    },
    "android": {
      "package": "com.lirune.reader",
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/epub+zip" },
            { "scheme": "file", "mimeType": "application/epub+zip" },
            { "scheme": "content", "mimeType": "*/*", "pathPattern": ".*\\.epub" },
            { "scheme": "file", "mimeType": "*/*", "pathPattern": ".*\\.epub" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        },
        {
          "action": "VIEW",
          "data": [
            { "scheme": "content", "mimeType": "application/pdf" },
            { "scheme": "file", "mimeType": "application/pdf" }
          ],
          "category": ["DEFAULT", "BROWSABLE"]
        }
      ],
      "permissions": [
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "MANAGE_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-sqlite"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
