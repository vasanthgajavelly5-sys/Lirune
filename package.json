{
  "name": "lirune",
  "productName": "Lirune Reader",
  "version": "5.5.0",
  "description": "A private, open-source Windows EPUB reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.js",
    "test": "node --test \"test/*.test.js\"",
    "audit": "npm audit --omit=dev",
    "pack": "electron-builder --dir",
    "validate:corpus": "node scripts/validate-corpus.js",
    "dist": "node scripts/build-win.js",
    "dist:win": "node scripts/build-win.js",
    "dist:store": "node scripts/build-store.js",
    "validate:release": "node scripts/validate-release.js",
    "validate:release:store": "node scripts/validate-release.js --store",
    "validate:release:config": "node scripts/validate-release.js --config",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "epub",
    "reader",
    "books",
    "desktop",
    "windows"
  ],
  "author": "Vasanth Gajavelly",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasanthgajavelly5-sys/Lirune.git"
  },
  "bugs": {
    "url": "https://github.com/vasanthgajavelly5-sys/Lirune/issues"
  },
  "homepage": "https://github.com/vasanthgajavelly5-sys/Lirune#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^44.3.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novera.reader",
    "productName": "Lirune Reader",
    "copyright": "Copyright © 2026 Vasanth Gajavelly",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "main.js",
      "preload.js",
      "scripts/storage-contract.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "node_modules/epubjs/**/*",
      "node_modules/jszip/**/*",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdfjs-dist/LICENSE",
      "node_modules/pdfjs-dist/LICENSE.notes",
      "!node_modules/epubjs/{documentation,examples,lib,src,types,node_modules}{,/**}",
      "!node_modules/epubjs/{.babelrc.json,.eslintrc.js,.nojekyll,.watchmanconfig,bower.json,documentation.yml,webpack.config.js}",
      "!node_modules/epubjs/dist/{epub.js,epub.legacy.js,epub.legacy.min.js,epub.js.map}",
      "!node_modules/jszip/{.codeclimate.yml,.editorconfig,.eslintrc.js,.jekyll-metadata,.travis.yml,CHANGES.md,deps.js,graph.svg,sponsors.md,tsconfig.json,vendor,node_modules}{,/**}",
      "!node_modules/jszip/dist/jszip.js",
      "!node_modules/pdfjs-dist/{image_decoders,legacy,types,web}{,/**}",
      "!node_modules/pdfjs-dist/{CODE_OF_CONDUCT.md,webpack.mjs}",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs,pdf.worker.mjs}",
      "!node_modules/pdfjs-dist/build/*.mjs.map",
      "!node_modules/@napi-rs{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "fileAssociations": [
        {
          "ext": "epub",
          "name": "EPUB Electronic Publication",
          "description": "Electronic Publication Book File",
          "role": "Viewer",
          "icon": "assets/icon.ico"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lirune Reader",
      "uninstallDisplayName": "Lirune Reader",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "LICENSE",
      "include": "build/installer.nsh"
    }
  },
  "dependencies": {
    "epubjs": "^0.3.93",
    "jszip": "^3.10.1",
    "pdfjs-dist": "^4.10.38"
  }
}
