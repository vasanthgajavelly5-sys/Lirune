{
  "expo": {
    "name": "Lirune Reader",
    "slug": "lirune-reader",
    "version": "4.6.7",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1D"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "lirune",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lirune.reader"
    },
    "android": {
      "package": "com.lirune.reader",
      "versionCode": 5,
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/epub+zip"
            },
            {
              "scheme": "file",
              "mimeType": "application/epub+zip"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.epub"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.epub"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "file",
              "mimeType": "application/pdf"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.pdf"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.pdf"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        },
        {
          "action": "VIEW",
          "data": [
            {
              "scheme": "content",
              "mimeType": "text/plain"
            },
            {
              "scheme": "file",
              "mimeType": "text/plain"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.txt"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.txt"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.html"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.html"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.htm"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.htm"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.fb2"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.fb2"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mobi"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.mobi"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.azw"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.azw"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.azw3"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.azw3"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.djvu"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.djvu"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.docx"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.docx"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.odt"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.odt"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.rtf"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.rtf"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.doc"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.doc"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.chm"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.chm"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.cbz"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.cbz"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.cbr"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.cbr"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.zip"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.zip"
            },
            {
              "scheme": "content",
              "mimeType": "*/*",
              "pathPattern": ".*\\.rar"
            },
            {
              "scheme": "file",
              "mimeType": "*/*",
              "pathPattern": ".*\\.rar"
            }
          ],
          "category": [
            "DEFAULT",
            "BROWSABLE"
          ]
        }
      ],
      "permissions": [
        "VIBRATE",
        "MANAGE_EXTERNAL_STORAGE",
        "READ_EXTERNAL_STORAGE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-sqlite",
      "./plugins/withLiruneStorage",
      "./plugins/withCutoutMode",
      "./plugins/withAndroidConfigChanges",
      "./plugins/withReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": ["arm64-v8a", "x86_64"]
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
