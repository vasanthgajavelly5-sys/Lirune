{
  "expo": {
    "name": "Lirune Reader",
    "slug": "lirune-reader",
    "version": "4.9.2",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1D"
    },
    "userInterfaceStyle": "automatic",
    "scheme": "lirune",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lirune.reader"
    },
    "android": {
      "package": "com.lirune.reader",
      "versionCode": 10,
      "adaptiveIcon": {
        "backgroundColor": "#1A1A1D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "permissions": [
        "VIBRATE"
      ],
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-document-picker",
      "expo-sqlite",
      "./plugins/withLiruneStorage",
      "./plugins/withLiruneScreen",
      "./plugins/withCutoutMode",
      "./plugins/withAndroidConfigChanges",
      "./plugins/withReleaseSigning",
      [
        "expo-build-properties",
        {
          "android": {
            "buildArchs": [
              "arm64-v8a",
              "x86_64"
            ]
          }
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1A1A1D",
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "dark": {
            "backgroundColor": "#1A1A1D",
            "image": "./assets/splash-icon.png"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
