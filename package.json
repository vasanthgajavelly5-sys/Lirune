{
  "name": "lirune",
  "productName": "Lirune Reader",
  "version": "6.0.0",
  "description": "A private, open-source Windows EPUB reader",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lint": "node scripts/lint.js",
    "check:modernization": "node scripts/check-modernization.js",
    "test": "node scripts/run-tests.js all",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/run-tests.js integration",
    "test:e2e": "node test/e2e/desktop-e2e.test.mjs",
    "test:all": "npm test && npm run test:e2e",
    "postinstall": "node node_modules/electron/install.js",
    "audit": "npm audit",
    "audit:prod": "node scripts/audit-prod.js",
    "pack": "node -r ./scripts/builder-env-hook.js ./node_modules/electron-builder/cli.js --dir",
    "validate:corpus": "node scripts/validate-corpus.js",
    "validate:formats": "node scripts/validate-format-catalogue.js",
    "dist": "node scripts/build-win.js",
    "dist:win": "node scripts/build-win.js",
    "dist:store": "node scripts/build-store.js",
    "validate:release": "node scripts/validate-release.js",
    "validate:release:store": "node scripts/validate-release.js --store",
    "validate:release:config": "node scripts/validate-release.js --config",
    "build": "electron-builder --win nsis"
  },
  "keywords": [
    "epub",
    "reader",
    "books",
    "desktop",
    "windows"
  ],
  "author": "Vasanth Gajavelly",
  "license": "GPL-3.0-only",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/vasanthgajavelly5-sys/Lirune.git"
  },
  "bugs": {
    "url": "https://github.com/vasanthgajavelly5-sys/Lirune/issues"
  },
  "homepage": "https://github.com/vasanthgajavelly5-sys/Lirune#readme",
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "electron": "^45.3.1",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.novera.reader",
    "productName": "Lirune Reader",
    "copyright": "Copyright © 2026 Vasanth Gajavelly",
    "artifactName": "${productName}-${version}-Setup.${ext}",
    "directories": {
      "output": "dist"
    },
    "files": [
      "LICENSE",
      "THIRD_PARTY_NOTICES.md",
      "main.js",
      "preload.js",
      "scripts/storage-contract.js",
      "index.html",
      "css/**/*",
      "js/**/*",
      "assets/**/*",
      "node_modules/epubjs/**/*",
      "node_modules/jszip/**/*",
      "node_modules/libarchive-wasm/**/*",
      "node_modules/pst-parser/**/*",
      "node_modules/msg-parser/**/*",
      "node_modules/utif/**/*",
      "node_modules/libheif-js/**/*",
      "node_modules/xlsb-parser/**/*",
      "node_modules/cfb/**/*",
      "node_modules/pdfjs-dist/build/pdf.min.mjs",
      "node_modules/pdfjs-dist/build/pdf.worker.min.mjs",
      "node_modules/pdfjs-dist/LICENSE",
      "node_modules/pdfjs-dist/LICENSE.notes",
      "!node_modules/epubjs/{documentation,examples,lib,src,types,node_modules}{,/**}",
      "!node_modules/epubjs/{.babelrc.json,.eslintrc.js,.nojekyll,.watchmanconfig,bower.json,documentation.yml,webpack.config.js}",
      "!node_modules/epubjs/dist/{epub.js,epub.legacy.js,epub.legacy.min.js,epub.js.map}",
      "!node_modules/jszip/{.codeclimate.yml,.editorconfig,.eslintrc.js,.jekyll-metadata,.travis.yml,CHANGES.md,deps.js,graph.svg,sponsors.md,tsconfig.json,vendor,node_modules}{,/**}",
      "!node_modules/jszip/dist/jszip.js",
      "!node_modules/pdfjs-dist/{image_decoders,legacy,types,web}{,/**}",
      "!node_modules/pdfjs-dist/{CODE_OF_CONDUCT.md,webpack.mjs}",
      "!node_modules/pdfjs-dist/build/{pdf.mjs,pdf.sandbox.mjs,pdf.sandbox.min.mjs,pdf.worker.mjs}",
      "!node_modules/pdfjs-dist/build/*.mjs.map",
      "!node_modules/libarchive-wasm/src{,/**}",
      "!node_modules/@napi-rs{,/**}"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "dir",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "fileAssociations": [
        { "ext": "epub", "name": "EPUB Electronic Publication", "description": "EPUB Publication", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "pdf", "name": "Portable Document Format", "description": "PDF Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "mobi", "name": "Mobipocket E-Book", "description": "MOBI E-Book", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "azw", "name": "Kindle E-Book", "description": "Kindle E-Book", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "azw3", "name": "Kindle Format 8", "description": "Kindle KF8 E-Book", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "fb2", "name": "FictionBook 2.0", "description": "FictionBook 2.0", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "fbz", "name": "Compressed FictionBook", "description": "Compressed FictionBook", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "cbz", "name": "Comic Book Archive (ZIP)", "description": "Comic Book ZIP Archive", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "cbr", "name": "Comic Book Archive (RAR)", "description": "Comic Book RAR Archive", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "cbt", "name": "Comic Book Archive (TAR)", "description": "Comic Book TAR Archive", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "cb7", "name": "Comic Book Archive (7Z)", "description": "Comic Book 7Z Archive", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "docx", "name": "Microsoft Word Document", "description": "Word Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "doc", "name": "Microsoft Word 97-2004 Document", "description": "Legacy Word Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "odt", "name": "OpenDocument Text", "description": "OpenDocument Text Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "rtf", "name": "Rich Text Format", "description": "Rich Text Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "txt", "name": "Plain Text Document", "description": "Text Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "md", "name": "Markdown Document", "description": "Markdown Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "markdown", "name": "Markdown Document", "description": "Markdown Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "html", "name": "HTML Document", "description": "HyperText Markup Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "htm", "name": "HTML Document", "description": "HyperText Markup Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "chm", "name": "Compiled HTML Help", "description": "Compiled HTML Help File", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "djvu", "name": "DjVu Document", "description": "DjVu Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "djv", "name": "DjVu Document", "description": "DjVu Document", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "ppt", "name": "PowerPoint Presentation", "description": "PowerPoint Presentation", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "png", "name": "PNG Image", "description": "Portable Network Graphic", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "jpg", "name": "JPEG Image", "description": "JPEG Image File", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "jpeg", "name": "JPEG Image", "description": "JPEG Image File", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "tiff", "name": "TIFF Image", "description": "Tagged Image File", "role": "Viewer", "icon": "assets/icon.ico" },
        { "ext": "tif", "name": "TIFF Image", "description": "Tagged Image File", "role": "Viewer", "icon": "assets/icon.ico" }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Lirune Reader",
      "uninstallDisplayName": "Lirune Reader",
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeaderIcon": "assets/icon.ico",
      "license": "LICENSE",
      "include": "scripts/nsis-include.nsh"
    }
  },
  "dependencies": {
    "cfb": "1.2.2",
    "epubjs": "^0.3.93",
    "jszip": "^3.10.2",
    "libarchive-wasm": "1.2.0",
    "libheif-js": "^1.23.5",
    "msg-parser": "^1.0.10",
    "pdfjs-dist": "^4.10.38",
    "pst-parser": "^0.0.7",
    "utif": "^3.1.0",
    "xlsb-parser": "^1.0.0-rc.2"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.15",
    "minimatch": "^11.0.8",
    "undici": "^7.30.1",
    "node-gyp": {
      "undici": "^6.29.1"
    }
  }
}
