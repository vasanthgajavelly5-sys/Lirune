{
  "name": "mobile",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "expo": "~57.0.23",
    "expo-constants": "^15.0.0",
    "expo-document-picker": "^57.0.2",
    "expo-file-system": "~57.0.7",
    "expo-linking": "^57.0.0",
    "expo-router": "~5.0.0",
    "expo-sqlite": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "jszip": "^3.10.2",
    "query-string": "^9.5.1",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-reanimated": "~3.10.1",
    "react-native-safe-area-context": "4.10.5",
    "react-native-screens": "~3.31.1",
    "react-native-webview": "13.16.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@babel/core": "^7.24.0",
    "@types/jest": "^30.0.0",
    "@types/jszip": "^3.4.0",
    "@types/react": "~19.2.2",
    "@types/react-native": "^0.72.8",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.2",
    "jest": "^30.5.2",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "tsc --noEmit"
  },
  "private": true,
  "expo": {
    "name": "Lirune Reader",
    "slug": "lirune-reader",
    "version": "4.0.3",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A1D"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lirune.reader"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A1D"
      },
      "package": "com.lirune.reader"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "scheme": "lirune",
    "plugins": [
      "expo-router",
      "expo-document-picker"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
